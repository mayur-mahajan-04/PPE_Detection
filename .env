# =============================================================================
# [NEW FILE] .env  —  Alert System Configuration
# Copy this file, fill in your real values, and keep it OUT of version control.
# Add ".env" to your .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Feature Flags  (set to "true" to enable, "false" to disable)
# ---------------------------------------------------------------------------
ALERT_EMAIL_ENABLED="true"
ALERT_TELEGRAM_ENABLED="true"

# ---------------------------------------------------------------------------
# Email / SMTP Settings
# For Gmail: enable 2FA and generate an App Password at
#   https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=shrawanidharmadhikari@gmail.com
SMTP_PASSWORD="qggg gfsx vnfg wugp"
# ALERT_TO=shrawanidharmadhikari08@gmail.com

# ---------------------------------------------------------------------------
# Telegram Bot Settings
# 1. Create a bot via @BotFather on Telegram → copy the token below
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8673414617:AAG-RW1WPnzulEH-Kv481ry1nFRQIr2XWGQ
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------------------------------------------------------------------------
# Alert Behaviour
# ---------------------------------------------------------------------------
# Minimum seconds between repeated alerts for the same violation type
ALERT_COOLDOWN_SECONDS=10

# Static location label included in every alert message
ALERT_LOCATION=Zone A

# Path to the CSV file where all dispatched alerts are logged
ALERT_LOG_FILE=violation_logs/alert_log.csv
